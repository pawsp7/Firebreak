{
  "name": "firebreak",
  "version": "1.0.0",
  "private": true,
  "description": "See what's ahead, and look after each other — a calm 24-hour wildfire outlook for Alberta communities.",
  "scripts": {
    "dev": "next dev --turbopack --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "postinstall": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/maplibre-gl-worker.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "next": "^15.5.9",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
